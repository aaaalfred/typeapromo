# Copia este fichero a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca subas secretos reales al repositorio.

# ─── Núcleo ───────────────────────────────────────────────────────────────────
# Con docker-compose el host es `postgres`; en local sin contenedores, `localhost`.
DATABASE_URL=postgresql://typeapromo:typeapromo@localhost:5432/typeapromo
PUBLIC_BASE_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio
AUTH_URL=http://localhost:3000

# ─── Correo transaccional (Resend) ────────────────────────────────────────────
# Si no se define RESEND_API_KEY, los correos se imprimen en consola (modo desarrollo).
RESEND_API_KEY=
EMAIL_FROM="Typeapromo <onboarding@resend.dev>"

# ─── Facturación y suscripciones (Stripe) ────────────────────────────────────
# Si no se define STRIPE_SECRET_KEY, la app opera en modo Free sin pasarela de pago.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ─── Slack (Opcional / Stand-by) ──────────────────────────────────────────────
# Sign in with Slack / OpenID Connect. Scopes: openid, profile, email.
# Si no se configuran las credenciales, el botón de Slack no aparece en login.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Workspace autorizado; se compara con el claim https://slack.com/team_id.
SLACK_TEAM_ID=

# ─── Bypass de autenticación (solo desarrollo y CI) ───────────────────────────
# Con valor `1` habilita el login sin credenciales y /api/health devuelve
# authMode: "dev-bypass". DEBE ESTAR AUSENTE EN PRODUCCIÓN.
AUTH_DEV_BYPASS=1

# ─── Almacenamiento S3-compatible (Cloudflare R2; MinIO en local) ─────────────
# R2: https://<account-id>.r2.cloudflarestorage.com   ·   MinIO: http://localhost:9000
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_STAGING=forms-media-staging
R2_BUCKET_PUBLIC=forms-media-public
# Dominio público de lectura del bucket público.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/forms-media-public
# `1` en local con MinIO; ausente o `0` con R2.
S3_FORCE_PATH_STYLE=1

# ─── Limpieza programada ──────────────────────────────────────────────────────
# Secreto de cabecera para POST /api/internal/cleanup, invocado por el cron del host.
CLEANUP_SECRET=cambia-esto-por-un-secreto-aleatorio
